# Server Port
PORT=5000

# MongoDB Connection String (Atlas or local)
# Replace with your actual MongoDB Atlas URI in .env:
# e.g., mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/linkvault?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/linkvault

# Base URL for generated short links (in development, points to backend server)
BASE_URL=http://localhost:5000

# Client URL (frontend origin for CORS and "Return to LinkVault" links on error pages)
CLIENT_URL=http://localhost:5173
